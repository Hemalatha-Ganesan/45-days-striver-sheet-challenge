class Solution {
    public int[] findPeakGrid(int[][] mat)
     {
        int r = mat.length;
        int c = mat[0].length;
        for(int i=0;i<r;i++)
        {
            for(int j=0;j<c;j++)
            {
                int curr = mat[i][j];
                if((i == 0 || curr > mat[i-1][j]) && 
                   (i == r -1 || curr > mat[i+1][j]) && 
                   (j == 0 || curr > mat[i][j-1]) && 
                   (j == c-1 || curr > mat[i][j+1])){
                    return new int[]{i,j};
                   }
            }
        }
        return new int[]{-1,-1};
    }
}
